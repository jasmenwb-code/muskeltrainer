{
  "rules": {
    "lobby": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === null || newData.child('nick').isString()"
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "users": {
      ".read": "auth != null",
      ".indexOn": [
        "score",
        "nameLower"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "nameLower": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "code": {
          ".validate": "newData.isString() && root.child('codes').child(newData.val()).val() === $uid"
        },
        "photo": {
          ".validate": "newData.isString() && newData.val().length < 60000"
        },
        "stats": {
          ".validate": false
        },
        "score": {
          ".validate": false
        },
        "lastGid": {
          ".validate": false
        },
        "lastSeen": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "codes": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$fid": {
          ".write": "auth != null && ((!newData.exists() && (auth.uid === $uid || auth.uid === $fid)) || (newData.val() === true && ((auth.uid === $uid && root.child('requests').child($uid).child($fid).exists()) || (auth.uid === $fid && root.child('requests').child($fid).child($uid).exists()))))"
        }
      }
    },
    "requests": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$from": {
          ".read": "auth != null && auth.uid === $from",
          ".write": "auth != null && ((auth.uid === $from && $from !== $to && (!newData.exists() || !root.child('friends').child($to).child($from).exists())) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('at').val() === now"
        }
      }
    },
    "sent": {
      "$from": {
        ".read": "auth != null && auth.uid === $from",
        "$to": {
          ".write": "auth != null && ((auth.uid === $from && $from !== $to) || (auth.uid === $to && !newData.exists()))",
          ".validate": "newData.val() === true"
        }
      }
    },
    "h2h": {
      ".read": "auth != null"
    },
    "games": {
      "$gid": {
        ".read": "auth != null",
        "host": {
          ".write": "auth != null && !data.exists() && newData.val() === auth.uid"
        },
        "op": {
          ".write": "auth != null && !data.exists() && newData.parent().child('host').val() === auth.uid && newData.isString() && newData.val() !== auth.uid"
        },
        "qs": {
          ".write": "auth != null && !data.exists() && newData.parent().child('host').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.val() === true && newData.parent().parent().child('host').exists() && !data.parent().parent().child('end').exists()"
          }
        },
        "start": {
          "$r": {
            ".write": "auth != null && !data.exists() && data.parent().parent().child('host').val() === auth.uid && !data.parent().parent().child('end').exists()",
            ".validate": "newData.val() === now"
          }
        },
        "ans": {
          "$uid": {
            "$r": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && data.parent().parent().parent().child('players').child($uid).exists() && data.parent().parent().parent().child('start').child($r).exists() && !data.parent().parent().parent().child('end').exists()",
              ".validate": "newData.hasChildren(['c', 'at']) && newData.child('c').isString() && newData.child('c').val().length <= 12 && newData.child('at').val() === now"
            }
          }
        },
        "end": {
          ".write": "auth != null && !data.exists() && data.parent().child('host').val() === auth.uid",
          ".validate": "newData.val() === now"
        }
      }
    }
  }
}